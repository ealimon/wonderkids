{
  "appId": "com.limon.storybookeducation",
  "appName": "WonderKids Adventure Portal",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "ios": {
    "minVersion": "16.0",
    "contentInset": "always",
    "allowsLinkPreview": false,
    "handleApplicationURL": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#EEF2F6",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "body",
      "style": "light"
    }
  }
}
